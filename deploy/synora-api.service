[Unit]
Description=Synora API (FastAPI)
Documentation=https://back.synora-ai.uz/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=synora
Group=synora
WorkingDirectory=/opt/synora-backend

# One worker on purpose, and on Postgres the reason changes rather than goes
# away. SQLite was the first one: concurrent writers from a second process hit
# "database is locked". What is left after the move is `app/core/metrics.py` —
# the Prometheus registry is per-process, so a second worker means Prometheus
# scrapes whichever one the proxy hands it and every counter reports a fraction
# of the traffic. `settings.serves_metrics` switches /metrics off rather than
# publish that, so raising this costs the dashboard until somebody wires up
# prometheus_client's multiprocess mode. Declare the same number in
# `WORKER_COUNT` either way: it is what `assert_production_ready` checks
# against, and it cannot read this file.
ExecStart=/opt/synora-backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8010 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# --- Hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# ProtectSystem=strict makes everything read-only. `data/` is the one exception:
# the SQLite database until the Postgres move, and `RECORDINGS_DIR` for good --
# every kept synthesis writes an audio file there.
ReadWritePaths=/opt/synora-backend/data

[Install]
WantedBy=multi-user.target
