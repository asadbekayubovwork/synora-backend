[Unit]
Description=Synora API (FastAPI)
Documentation=https://back.synora-ai.uz/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=synora
Group=synora
WorkingDirectory=/opt/synora-backend

# One worker on purpose: the database is SQLite, and concurrent writers from a
# second process would hit "database is locked". Raise this only alongside a
# move to Postgres.
ExecStart=/opt/synora-backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8010 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# --- Hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# ProtectSystem=strict makes everything read-only; the database needs an exception.
ReadWritePaths=/opt/synora-backend/data

[Install]
WantedBy=multi-user.target
