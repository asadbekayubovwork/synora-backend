# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Everything here has a working default for local
# development, except JWT_SECRET which you must set before deploying.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
# Echoes every SQL statement, the password and OTP hash columns
# included. Fine on a laptop; `assert_production_ready` refuses to
# boot with it on, so a copy of this file cannot carry it into
# production silently.
DEBUG=true

# SQLite by default; for Postgres use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synora
DATABASE_URL=sqlite+aiosqlite:///./synora.db

# openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# OAuth. Leave a provider's credentials out and its button disappears from
# GET /auth/oauth/providers; nothing else breaks.
# ---------------------------------------------------------------------------

# Where the provider sends the browser back. Comma separated, and matched
# EXACTLY -- an unchecked redirect turns a leaked client id into a code thief.
# These are frontend routes, not API ones, and each must also be registered
# with the provider itself. The first entry is the default.
OAUTH_REDIRECT_URIS=http://localhost:3000/auth/callback
# OAUTH_REDIRECT_URIS=https://synora-ai.uz/auth/callback,https://www.synora-ai.uz/auth/callback

# How long a sign-in may sit between /authorize and /callback.
OAUTH_STATE_TTL_MINUTES=10

# --- Google -----------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# -> Web application. Add every OAUTH_REDIRECT_URIS entry under "Authorized
# redirect URIs". Scopes needed: openid, email, profile (all default).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- GitHub -----------------------------------------------------------------
# github.com/settings/developers -> New OAuth App. "Add callback URL" takes up
# to 10, so dev and production can share one app.
# GITHUB_CLIENT_ID=Ov23liD9Vngo9Z33oopz
# GITHUB_CLIENT_SECRET=942475da82df55cf23cdc944eb57c3221ff395fe

# --- Telegram ---------------------------------------------------------------
# Talk to @BotFather: /newbot, then /setdomain with the frontend's domain --
# the widget refuses to load anywhere else. There is no redirect and no
# secret: the bot token is what verifies the widget's signature, so treat it
# exactly like JWT_SECRET.
# Telegram gives no email address, so accounts created this way have none.
# TELEGRAM_BOT_TOKEN=8021160698:AAFnsEw6D-uMrRqUM9k811jtwAE0--GDkzM
# TELEGRAM_BOT_USERNAME=synora_login_bot
# How old a widget payload may be, in seconds (default one day).
# TELEGRAM_AUTH_TTL_SECONDS=86400

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Sign-in throttle. Checking a password is the most expensive thing an
# unauthenticated caller can ask for — one bcrypt is ~220 ms of a core — and
# `/auth/login` runs it even for an address with no account, so that the answer
# cannot be used to discover which emails are registered. Two windows because
# the attacks are different shapes: many passwords against one account is
# caught per-address, one password against many accounts is caught per-IP. The
# per-IP number is looser because an office behind one NAT is normal.
#
# Counted in Redis. Without REDIS_URL this is off rather than broken.
LOGIN_MAX_PER_EMAIL=5
LOGIN_MAX_PER_IP=30
LOGIN_WINDOW_SECONDS=60

# With no SMTP_HOST the mailer prints the code to the console instead of
# sending. Uncomment one block below to send for real.

# --- Gmail: quickest to try -------------------------------------------------
# Needs an App Password (2-step verification must be on) — your normal Gmail
# password will not authenticate. Capped near 500 messages a day, and the From
# address is forced to your Gmail one, so this is for testing rather than launch.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM=Synora <you@gmail.com>

# --- Resend: sends as no-reply@synora-ai.uz ---------------------------------
# SMTP_USER is the literal word "resend"; the password is the API key.
# Add the SPF/DKIM records Resend shows for the domain in the ahost.uz DNS
# panel first, or Gmail will file the code as spam.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx
# SMTP_FROM=Synora-AI <no-reply@synora-ai.uz>

# --- Brevo ------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-smtp-key
# SMTP_FROM=Synora-AI <no-reply@synora-ai.uz>

# --- The domain's own mail server -------------------------------------------
# synora-ai.uz already has MX, SPF, DKIM and DMARC, but nothing answered on
# 25/465/587 when this was written — the host firewalls SMTP. Ask ahost.uz to
# open it and to confirm the mailbox exists, then this block needs no DNS work.
# SMTP_HOST=mail.synora-ai.uz
# SMTP_PORT=587
# SMTP_USER=no-reply@synora-ai.uz
# SMTP_PASSWORD=your-mailbox-password
# SMTP_FROM=Synora-AI <no-reply@synora-ai.uz>

SMTP_FROM=Synora <no-reply@synora.ai>
SMTP_STARTTLS=true

# Returns the OTP in the API response so you can test without a mailbox.
# Ignored unless ENVIRONMENT=development.
EXPOSE_DEV_OTP=true

# Comma separated. The Nuxt dev server runs on :3000; add the live origins
# (not the API's own address) when deploying. `*` is refused outside development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=https://synora-ai.uz,https://www.synora-ai.uz

# ---- Redis --------------------------------------------------------------------
#
# Optional, and the code means it: leave REDIS_URL empty and every cache and
# counter falls back to a Postgres query. The whole test suite runs that way, so
# the fallback is exercised rather than merely intended.
#
# It stops being optional the moment there is more than one uvicorn worker: the
# background-job lease and the balance event stream both need a shared place to
# coordinate, and the app refuses to boot with WORKER_COUNT > 1 and no Redis.
#
# The host runs several unrelated projects, so every key is namespaced.
#
# REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=synora:

# Declared, not detected — uvicorn's worker count cannot be read back reliably,
# and an honest declared value beats a clever wrong one. Used only to refuse a
# multi-worker boot without Redis.
WORKER_COUNT=1

# ---- Text to speech -----------------------------------------------------------
#
# The TTS box is upstream of us and holds an sk_live_ key. That key never
# leaves this server: the browser calls /api/v1/tts/speech with its own JWT, we
# place a wallet hold, stream the audio through and settle against the text we
# were given. Handing the key to a frontend instead would be one line of code
# and would put metering — the entire product — in the browser's hands.
#
# Leave TTS_BASE_URL or TTS_API_KEY empty and every /tts route answers 503
# `tts_not_configured`; nothing else in the API changes. Setting one without
# the other is the case refused at boot outside development, because a
# half-wired upstream looks available right up to the first request.
#
# TTS_BASE_URL=https://art-wagner-michael-occupation.trycloudflare.com
# TTS_API_KEY=sk_live_replace-me

# Which price book row synthesis is billed against, alongside the service name
# `tts`. Change it only together with a seeded price for the same model key:
# an unpriced metric does not charge zero, it raises.
TTS_MODEL_KEY=synora-tts

# Connecting is either quick or hopeless; reading a long high-fidelity stream
# legitimately takes minutes. One shared timeout would either cut audio the
# user has already been charged for or pin dead sockets to live wallet holds.
TTS_CONNECT_TIMEOUT_SECONDS=10
TTS_READ_TIMEOUT_SECONDS=300

# Upstream's own per-request cap, restated here so the rejection is ours, with
# our error code, and arrives before a hold is placed and released again.
TTS_MAX_CHARACTERS=5000

# Concurrent syntheses per user. The counter lives in Redis, so with REDIS_URL
# empty there is no cap — the same trade the rest of the app makes.
TTS_MAX_CONCURRENT_PER_USER=3

# Batch limits, ours and far below upstream's 5000 items. One job is one hold
# against one wallet, and a job big enough to reserve someone's whole balance
# for hours is a support ticket rather than a feature.
TTS_BATCH_MAX_ITEMS=500
TTS_BATCH_MAX_CHARACTERS=500000

# How often a submitted job is polled, and how long it may run before it is
# declared expired and settled at the last usage upstream reported. Six hours
# is longer than the biggest job we accept takes on one card.
TTS_BATCH_POLL_SECONDS=10
TTS_BATCH_MAX_POLL_SECONDS=21600

# ---- RabbitMQ -----------------------------------------------------------------
#
# Optional in exactly the way Redis is, and the code means it: leave
# RABBITMQ_URL empty and batch jobs are submitted inline by the API request
# that created them, with no worker running anywhere. That is not a degraded
# mode, it is a supported one — upstream's own POST /v1/batch answers in
# milliseconds, and a queue that is merely absent must not become an outage.
# The test suite runs this way, so the fallback is exercised rather than
# intended.
#
# What the broker buys when it is there is not "async". It is admission
# control in front of a single GPU: RABBITMQ_PREFETCH is the number of batch
# items in flight against the card. Raising it does not make the card faster —
# it moves the queue out of RabbitMQ and into the card's own scheduler, where
# nothing can reorder, delay or cancel it. Treat it as a ceiling, not a
# throughput knob.
#
# Streaming synthesis never goes through the queue, and neither does the
# ledger; see docs/QUEUEING.md for where it is deliberately not used.
#
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# The host runs several unrelated projects, so exchanges and queues are
# namespaced the same way the Redis keys are.
RABBITMQ_PREFIX=synora.
RABBITMQ_PREFETCH=4

# A publish that hangs must not hold up the HTTP response waiting on it. Past
# this the API stops waiting for the broker and submits the job inline.
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5

# Run the consumer:  python -m app.workers.tts_batch

# ---- Credits ------------------------------------------------------------------
#
# The AI services are metered in **micro-credits**: 1 credit = 1 000 000 micros.
# That scale exists because one LLM token can cost a small fraction of a credit,
# and anything coarser would round individual charges to zero. Nothing here is
# ever a float — balances, prices and charges are all integers.
#
# Prices themselves are NOT set here. They live in the database, versioned, and
# are published through the admin API, so changing what a character costs needs
# no deploy and every old invoice stays reproducible. Same for the som-per-credit
# rate. Run `python devtools/seed_price_book.py` to get a working set locally.

# Credit granted to a new account when it verifies. 0 disables it.
BILLING_SIGNUP_BONUS_MICROS=0
BILLING_SIGNUP_BONUS_DAYS=30

# Below this, the wallet reports `is_low` and the client should prompt a top-up.
# 0 disables it.
BILLING_LOW_BALANCE_MICROS=0

# How much unfunded usage a live call gets when it runs out of credit
# mid-sentence, before it ends cleanly. The overrun is written off, not lent: a
# prepaid product should not acquire a debt nobody will collect, and refusing to
# let a balance go negative keeps the strongest guarantees in the schema intact.
# 5 000 000 micros is five credits.
BILLING_GRACE_MICROS=5000000

# A realtime session reserves its whole ceiling up front and settles the
# difference at the end — there is no hold extension and no grace ladder, so
# `STT_STREAM_MAX_SECONDS` is what sizes the reservation. The knobs that used to
# sit here (BILLING_HOLD_SECONDS, _MIN_MICROS, _MAX_MICROS,
# _EXTEND_AT_PERCENT, BILLING_GRACE_SECONDS, BILLING_ROLLUP_TIMEZONE) described
# that lifecycle and were read by nothing; two of them could refuse a
# production boot while doing nothing at all. Removed rather than left to look
# load-bearing. Setting them now does nothing and costs nothing.

# ---- Internal API (the microservices) -----------------------------------------
#
# The TTS, STT, chat and voice-agent services call /internal/v1 with HMAC-signed
# requests. Their credentials are *derived* from this one master key rather than
# stored, so the service_api_keys table holds nothing secret and a database dump
# yields no usable credential. Revoking a key is one UPDATE — no deploy, no key
# redistribution.
#
# The trade, stated plainly: whoever holds this holds every service key. Same
# blast radius as JWT_SECRET, guarded the same way — the app refuses to start
# outside development if this is the default, shorter than 32 bytes, or equal to
# JWT_SECRET. It must never equal JWT_SECRET: sharing them would let a metering
# service mint user sessions.
#
#   openssl rand -hex 32
#
INTERNAL_KEY_SECRET=dev-internal-secret-change-me-before-deploying

# How far a signed request's clock may be from ours. Clock drift is the single
# commonest reason an integration that worked yesterday stops working today, so
# the rejection carries our own time in the response body.
INTERNAL_SIGNATURE_WINDOW_SECONDS=300

# A kill switch for the whole /internal surface, independent of the nginx ACL.
INTERNAL_API_ENABLED=true

# Mint a key:  python3 devtools/mint_service_key.py --service voice_agent --label "prod"
# Poke it:     python3 devtools/sign_internal_request.py GET /internal/v1/health
# The contract the other team codes against: docs/INTERNAL_API.md

# ---- Speech to text -----------------------------------------------------------
#
# A second gateway, same trade as the TTS one: our credential never leaves this
# process, the caller uses their own JWT, and every second of audio is metered
# here. Empty ⇒ `POST /stt/transcribe` answers 503 and nothing else changes.
#
# Note the header: this upstream authenticates with `X-Token`, where the speech
# box uses `X-API-Key`.
STT_BASE_URL=
STT_API_KEY=

# Which price book row transcription bills against. The seeded price is on the
# wildcard model key, so this only matters once two checkpoints are priced
# differently.
STT_MODEL_KEY=synora-stt

STT_CONNECT_TIMEOUT_SECONDS=10
# Whisper is near real time on a warm card, but a cold start loads the
# checkpoint first and the upload itself is on this clock too.
STT_READ_TIMEOUT_SECONDS=300

# Both refused before the wallet is touched.
STT_MAX_AUDIO_BYTES=26214400
STT_MAX_AUDIO_SECONDS=600

# How long a byte of *compressed* audio is assumed to be, for the hold only.
# 8000 B/s is 64 kbps where speech is usually 128, so the estimate lands above
# the true duration on purpose: an under-estimate is clamped at settlement and
# bills less than the work, which is the error nobody notices. WAV and PCM
# never use this — their duration is read out of the header exactly.
STT_ASSUMED_BYTES_PER_SECOND=8000

# Realtime transcription (`WS /stt/stream`). The cap on one live session, and
# what its hold is priced from: a websocket has no length until it ends, so
# credit is reserved for the whole allowance and the remainder comes back at
# settlement. At the seeded prices ten minutes reserves about 14 credits —
# which is also what an account needs before it can open a stream at all.
STT_STREAM_MAX_SECONDS=600

# A socket that has sent no audio for this long is closed and settled. It is
# what stops an abandoned browser tab from holding a GPU slot upstream and a
# wallet's credit until reconciliation comes past.
STT_STREAM_IDLE_SECONDS=60

# How long the tail of a finished session may take. After `stop`, or a hang-up,
# the gateway waits for upstream's last transcript — which is not optional, it
# is transcript the caller has paid for. This used to reuse
# STT_READ_TIMEOUT_SECONDS, whose 300 is sized for a cold model load on a file
# upload; the caller is billed for the wait, so an upstream that answers pings
# but never finishes was charging five minutes of dead air.
STT_STREAM_DRAIN_SECONDS=15

# ---- Voice agent --------------------------------------------------------------
#
# The third gateway, and the first one the audio does not pass through. The
# agent speaks WebRTC: the browser and the agent exchange audio directly over
# UDP, and all that reaches us is the negotiation — the SDP offer, its answer
# and a handful of ICE candidates. We relay those with the agent's key attached,
# so the key never reaches a browser, and bill the call by wall clock on a
# heartbeat the client sends every VOICE_AGENT_HEARTBEAT_SECONDS — because that
# heartbeat is the evidence this side has of how long a call lasted. The one
# check on it: when a client goes quiet, the agent is asked whether it still
# holds the call (an empty `PATCH /api/offer`), and a call it still holds keeps
# being billed. That answer is only believed after the agent 404s a made-up
# call id; an agent that does not is billed on heartbeats alone. A call that
# never heartbeats at all is billed from its answer only once the agent still
# holds it 90 s after a "nudge" — one unroutable ICE candidate that fails any
# peer still stuck in ICE — and 120 s after the answer; until then it is free,
# as a failed connect must be. Both graces are fixed in code.
# The contract the frontend codes against: docs/VOICE_AGENT.md
#
# The key is the `ui` entry in the agent's user roster. NEVER the `admin` one:
# that key is for maintenance from the agent's own box, and this one is used on
# behalf of every signed-in user here. Nobody but this server ever sends it, so
# a 401 from the agent is logged at ERROR and answered `503
# voice_agent_key_rejected` — somebody rotated the key and this file is stale.
#
# Leave either empty and `POST /voice/sessions` answers 503
# `voice_agent_not_configured`, while `GET /voice/config` answers
# `available: false` so the client can hide the call button. Setting one
# without the other is refused at boot outside development.
#
# The URL is a quick tunnel's shape on purpose: those change every time the
# tunnel restarts, and a stale one is `502 voice_agent_unreachable` on every
# call with nothing wrong on either box. Update it and restart. The tunnel only
# carries the signalling; the audio still needs a route to the agent's host.
#
# VOICE_AGENT_BASE_URL=https://your-agent.trycloudflare.com
# VOICE_AGENT_API_KEY=pv_ak_replace-me

# Which price book row a call bills against, beside the service `voice_agent`.
# Only `session_ms` is ever reported — the agent counts nothing for us — so the
# per-minute price on that row has to be the whole price of a minute of
# conversation, not a connection fee on top of components nobody reports. The
# seeded `voice_agent` rows are the second kind; publish an exact row for this
# model key before anyone is charged.
VOICE_AGENT_MODEL_KEY=synora-voice-agent

# Connecting is quick or hopeless. The offer is answered once the agent has
# built the call's pipeline — six to eight seconds on a warm agent, measured —
# and the first one after an agent restart can take thirty seconds of warm-up:
# shorter than that turns every cold start into a 502 the user retries into a
# second cold start. Together (45 s) they are the longest the offer itself can
# take; the checks before it — settling the account's dead calls, asking the
# agent whether a just-hung-up call has let go — add seconds more, and the
# sweep releases an offer still unanswered after twice the deadline (90 s).
# nginx's default proxy_read_timeout is 60 s: give `location /api/v1/voice/`
# `proxy_read_timeout 90s` (at least twice the offer deadline), and raise it
# with the offer timeout. An offer the proxy gives up on is a call the agent
# answered and the browser never heard about.
VOICE_AGENT_CONNECT_TIMEOUT_SECONDS=10
VOICE_AGENT_OFFER_TIMEOUT_SECONDS=35

# The ceiling on one call, and what its hold is priced from. There is no hold
# extension, so credit for the whole ceiling is reserved when the call opens
# and the unspent part comes back when it ends — which is also why an account
# with less than that cannot start a call at all. At least 60 outside
# development.
VOICE_AGENT_MAX_SESSION_SECONDS=600

# How often a connected client says the call is still up, and how long it may
# go quiet before the agent is asked about it. A call the agent still holds is
# kept and billed on; any other is over, billed to its last proof of life plus
# one interval and flagged `disputed`. Three missed beats rather than one,
# because a phone switching from wifi to mobile drops a request or two without
# the call dropping. Outside development the timeout must be at least twice the
# interval.
VOICE_AGENT_HEARTBEAT_SECONDS=15
VOICE_AGENT_HEARTBEAT_TIMEOUT_SECONDS=45

# Lines per account: live calls (refused `429 voice_call_limit`), plus ended
# calls whose connection the agent still holds (`429 voice_call_still_connected`,
# Retry-After 5) — a client that hangs up and leaves its peer connection open is
# still using the shared agent. An ended call that never connected counts only
# once it has proved it did, so a retry right after a failed connect is never
# refused. Counted from the rows rather than in Redis — a call outlives the
# request that opened it — so this holds with or without Redis. At least 1
# outside development.
VOICE_AGENT_MAX_CONCURRENT_PER_USER=1

# Calls an account may *start* in any 60 seconds, live or not. An open is cheap
# for us and a whole pipeline for the agent, and a client stuck in a reconnect
# loop is the likeliest way to find that out. Counted from the call rows in the
# database, so unlike the other throttles here it holds without REDIS_URL. With
# Redis, attempts are counted too — refused ones included, since each may probe
# the agent — at three times this a minute and never below 30. Both answer
# `429 voice_call_rate_limited`. There is no off switch: at least 1 outside
# development (the boot refuses 0); set it high to lift it. In development 0
# refuses every open.
VOICE_AGENT_MAX_OPENS_PER_MINUTE=10

# Handed to the browser verbatim, through `GET /voice/config`, for
# `new RTCPeerConnection({iceServers})`. JSON, because a TURN entry carries
# `username` and `credential` beside its URLs. STUN alone works on a LAN and
# behind most home routers; a call that works locally and not from another
# network — `connected` never reached, and charged nothing — needs TURN.
# Prefer the minted credentials below to a static one here: every signed-in
# account can read this list, so a password in it is shared and never expires.
# A `turn:`/`turns:` entry without both `username` and `credential` is refused
# at boot outside development — the browser's `RTCPeerConnection` throws on it.
#   VOICE_AGENT_ICE_SERVERS='[{"urls": ["stun:stun.l.google.com:19302"]}, {"urls": ["turn:turn.example.com:3478"], "username": "synora", "credential": "replace-me"}]'
VOICE_AGENT_ICE_SERVERS='[{"urls": ["stun:stun.l.google.com:19302"]}]'

# TURN with credentials minted per user — the "TURN REST" scheme coturn serves
# as `use-auth-secret`, with its `static-auth-secret` set to the same secret as
# here. `GET /voice/config` appends one entry per request: username
# `<expiry>:<user_id>`, credential `base64(hmac_sha1(secret, username))`. The
# TURN server needs no database, and a credential copied out of a browser stops
# working about when its call could no longer be running. Only handed out when
# the agent is configured. URLs comma separated; both or neither, and a secret
# of at least 16 bytes, outside development. The secret never leaves this
# process — generate one with `openssl rand -hex 32`.
# VOICE_AGENT_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# VOICE_AGENT_TURN_SECRET=replace-me
# How long a minted credential lasts. 0 means the call ceiling plus ten minutes.
VOICE_AGENT_TURN_TTL_SECONDS=0

# How often this process settles calls nobody hung up: past their ceiling, or
# quiet past the heartbeat timeout — each quiet one put to the agent first, and
# kept if the agent still holds it. A crashed tab reserves a whole ceiling of
# credit until something settles it, and the generic reaper deliberately will
# not — it would bill the whole ceiling. Runs with or without an agent
# configured: it needs only the database, and a deployment that has just turned
# the agent off still has holds to give back. Every worker runs its own loop,
# which is safe: a second settlement of a call is a replay of the first.
# `POST /admin/reconcile` runs the same pass on demand. 0 turns the loop off.
VOICE_AGENT_SWEEP_SECONDS=30

# ---- Metrics ------------------------------------------------------------------
#
# `GET /metrics`, for Prometheus. Off the API prefix, and off /internal too:
# Prometheus does not sign requests the way a microservice does, so the token
# below is the whole of its authentication.
#
# Recording is unconditional — this switch only decides whether the endpoint
# answers. A flag that silenced the counters as well would make a metrics bug
# look like an application bug.
METRICS_ENABLED=true

# Required outside development — without one `/metrics` answers 404 and the
# startup log says so. The reason is nginx: this API is reached through a
# `location /` proxy, so a route we add is public the moment it exists, and
# this one publishes call volumes, credit movements and how many wallets there
# are. It is not a boot failure, deliberately: a dashboard must never be able
# to fail a release of the API it watches.
#
#   openssl rand -hex 32
#
METRICS_TOKEN=

# The three aggregates read per scrape: credit held by unsettled sessions, open
# sessions, open batch jobs. No counter can know them — they survive restarts
# and they are sums of rows — and a hold that never came back is invisible
# without them.
METRICS_DB_GAUGES=true

# Local dashboard:  docker compose -f grafana/docker-compose.yml up -d
# Then:             http://localhost:3001

# ---- Recordings ---------------------------------------------------------------
#
# Keep every delivered synthesis: the text and its parameters in
# `tts_recordings`, the audio in a content-addressed file under the directory
# below. `GET /tts/recordings` lists them, `/audio` plays one back, and
# `DELETE /tts/recordings/{id}` erases one.
#
# Nothing on the billing path reads either, and a write that fails costs the
# recording rather than the synthesis — a full disk must never be able to break
# a stream somebody is paying for.
#
# It governs **both** gateways: `tts_recordings` keeps the text and the audio of
# every synthesis, `stt_transcriptions` keeps the upload and its transcript.
# They share one file store, so transcribing something you synthesised is one
# file with a row in each table.
#
# It does mean keeping customer text and customer audio indefinitely, and on
# the STT side that audio is what a *user* uploaded. There is no automatic
# expiry; `false` here turns both off.
RECORDINGS_ENABLED=true

# Relative to the working directory, which is /opt/synora-backend under
# systemd — inside the unit's one `ReadWritePaths=`, so `ProtectSystem=strict`
# does not have to be relaxed for it. Rough sizing: a wav is ~96 KB per second
# of speech at 48 kHz, so a thousand ten-second clips a day is about 1 GB.
RECORDINGS_DIR=data/recordings
