# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Everything here has a working default for local
# development, except JWT_SECRET which you must set before deploying.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# SQLite by default; for Postgres use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synora
DATABASE_URL=sqlite+aiosqlite:///./synora.db

# openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# OAuth. Leave a provider's credentials out and its button disappears from
# GET /auth/oauth/providers; nothing else breaks.
# ---------------------------------------------------------------------------

# Where the provider sends the browser back. Comma separated, and matched
# EXACTLY -- an unchecked redirect turns a leaked client id into a code thief.
# These are frontend routes, not API ones, and each must also be registered
# with the provider itself. The first entry is the default.
OAUTH_REDIRECT_URIS=http://localhost:3000/auth/callback
# OAUTH_REDIRECT_URIS=https://synora-ai.uz/auth/callback,https://www.synora-ai.uz/auth/callback

# How long a sign-in may sit between /authorize and /callback.
OAUTH_STATE_TTL_MINUTES=10

# --- Google -----------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# -> Web application. Add every OAUTH_REDIRECT_URIS entry under "Authorized
# redirect URIs". Scopes needed: openid, email, profile (all default).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- GitHub -----------------------------------------------------------------
# github.com/settings/developers -> New OAuth App. "Add callback URL" takes up
# to 10, so dev and production can share one app.
# GITHUB_CLIENT_ID=Ov23liD9Vngo9Z33oopz
# GITHUB_CLIENT_SECRET=942475da82df55cf23cdc944eb57c3221ff395fe

# --- Telegram ---------------------------------------------------------------
# Talk to @BotFather: /newbot, then /setdomain with the frontend's domain --
# the widget refuses to load anywhere else. There is no redirect and no
# secret: the bot token is what verifies the widget's signature, so treat it
# exactly like JWT_SECRET.
# Telegram gives no email address, so accounts created this way have none.
# TELEGRAM_BOT_TOKEN=8021160698:AAFnsEw6D-uMrRqUM9k811jtwAE0--GDkzM
# TELEGRAM_BOT_USERNAME=synora_login_bot
# How old a widget payload may be, in seconds (default one day).
# TELEGRAM_AUTH_TTL_SECONDS=86400

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# With no SMTP_HOST the mailer prints the code to the console instead of
# sending. Uncomment one block below to send for real.

# --- Gmail: quickest to try -------------------------------------------------
# Needs an App Password (2-step verification must be on) — your normal Gmail
# password will not authenticate. Capped near 500 messages a day, and the From
# address is forced to your Gmail one, so this is for testing rather than launch.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM=Synora <you@gmail.com>

# --- Resend: sends as no-reply@synora-ai.uz ---------------------------------
# SMTP_USER is the literal word "resend"; the password is the API key.
# Add the SPF/DKIM records Resend shows for the domain in the ahost.uz DNS
# panel first, or Gmail will file the code as spam.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx
# SMTP_FROM=Synora-AI <no-reply@synora-ai.uz>

# --- Brevo ------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-smtp-key
# SMTP_FROM=Synora-AI <no-reply@synora-ai.uz>

# --- The domain's own mail server -------------------------------------------
# synora-ai.uz already has MX, SPF, DKIM and DMARC, but nothing answered on
# 25/465/587 when this was written — the host firewalls SMTP. Ask ahost.uz to
# open it and to confirm the mailbox exists, then this block needs no DNS work.
# SMTP_HOST=mail.synora-ai.uz
# SMTP_PORT=587
# SMTP_USER=no-reply@synora-ai.uz
# SMTP_PASSWORD=your-mailbox-password
# SMTP_FROM=Synora-AI <no-reply@synora-ai.uz>

SMTP_FROM=Synora <no-reply@synora.ai>
SMTP_STARTTLS=true

# Returns the OTP in the API response so you can test without a mailbox.
# Ignored unless ENVIRONMENT=development.
EXPOSE_DEV_OTP=true

# Comma separated. The Nuxt dev server runs on :3000; add the live origins
# (not the API's own address) when deploying. `*` is refused outside development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=https://synora-ai.uz,https://www.synora-ai.uz

# ---- Redis --------------------------------------------------------------------
#
# Optional, and the code means it: leave REDIS_URL empty and every cache and
# counter falls back to a Postgres query. The whole test suite runs that way, so
# the fallback is exercised rather than merely intended.
#
# It stops being optional the moment there is more than one uvicorn worker: the
# background-job lease and the balance event stream both need a shared place to
# coordinate, and the app refuses to boot with WORKER_COUNT > 1 and no Redis.
#
# The host runs several unrelated projects, so every key is namespaced.
#
# REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=synora:

# Declared, not detected — uvicorn's worker count cannot be read back reliably,
# and an honest declared value beats a clever wrong one. Used only to refuse a
# multi-worker boot without Redis.
WORKER_COUNT=1

# ---- Text to speech -----------------------------------------------------------
#
# The TTS box is upstream of us and holds an sk_live_ key. That key never
# leaves this server: the browser calls /api/v1/tts/speech with its own JWT, we
# place a wallet hold, stream the audio through and settle against the text we
# were given. Handing the key to a frontend instead would be one line of code
# and would put metering — the entire product — in the browser's hands.
#
# Leave TTS_BASE_URL or TTS_API_KEY empty and every /tts route answers 503
# `tts_not_configured`; nothing else in the API changes. Setting one without
# the other is the case refused at boot outside development, because a
# half-wired upstream looks available right up to the first request.
#
# TTS_BASE_URL=https://art-wagner-michael-occupation.trycloudflare.com
# TTS_API_KEY=sk_live_replace-me

# Which price book row synthesis is billed against, alongside the service name
# `tts`. Change it only together with a seeded price for the same model key:
# an unpriced metric does not charge zero, it raises.
TTS_MODEL_KEY=synora-tts

# Connecting is either quick or hopeless; reading a long high-fidelity stream
# legitimately takes minutes. One shared timeout would either cut audio the
# user has already been charged for or pin dead sockets to live wallet holds.
TTS_CONNECT_TIMEOUT_SECONDS=10
TTS_READ_TIMEOUT_SECONDS=300

# Upstream's own per-request cap, restated here so the rejection is ours, with
# our error code, and arrives before a hold is placed and released again.
TTS_MAX_CHARACTERS=5000

# Concurrent syntheses per user. The counter lives in Redis, so with REDIS_URL
# empty there is no cap — the same trade the rest of the app makes.
TTS_MAX_CONCURRENT_PER_USER=3

# Batch limits, ours and far below upstream's 5000 items. One job is one hold
# against one wallet, and a job big enough to reserve someone's whole balance
# for hours is a support ticket rather than a feature.
TTS_BATCH_MAX_ITEMS=500
TTS_BATCH_MAX_CHARACTERS=500000

# How often a submitted job is polled, and how long it may run before it is
# declared expired and settled at the last usage upstream reported. Six hours
# is longer than the biggest job we accept takes on one card.
TTS_BATCH_POLL_SECONDS=10
TTS_BATCH_MAX_POLL_SECONDS=21600

# ---- RabbitMQ -----------------------------------------------------------------
#
# Optional in exactly the way Redis is, and the code means it: leave
# RABBITMQ_URL empty and batch jobs are submitted inline by the API request
# that created them, with no worker running anywhere. That is not a degraded
# mode, it is a supported one — upstream's own POST /v1/batch answers in
# milliseconds, and a queue that is merely absent must not become an outage.
# The test suite runs this way, so the fallback is exercised rather than
# intended.
#
# What the broker buys when it is there is not "async". It is admission
# control in front of a single GPU: RABBITMQ_PREFETCH is the number of batch
# items in flight against the card. Raising it does not make the card faster —
# it moves the queue out of RabbitMQ and into the card's own scheduler, where
# nothing can reorder, delay or cancel it. Treat it as a ceiling, not a
# throughput knob.
#
# Streaming synthesis never goes through the queue, and neither does the
# ledger; see docs/QUEUEING.md for where it is deliberately not used.
#
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# The host runs several unrelated projects, so exchanges and queues are
# namespaced the same way the Redis keys are.
RABBITMQ_PREFIX=synora.
RABBITMQ_PREFETCH=4

# A publish that hangs must not hold up the HTTP response waiting on it. Past
# this the API stops waiting for the broker and submits the job inline.
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5

# Run the consumer:  python -m app.workers.tts_batch

# ---- Credits ------------------------------------------------------------------
#
# The AI services are metered in **micro-credits**: 1 credit = 1 000 000 micros.
# That scale exists because one LLM token can cost a small fraction of a credit,
# and anything coarser would round individual charges to zero. Nothing here is
# ever a float — balances, prices and charges are all integers.
#
# Prices themselves are NOT set here. They live in the database, versioned, and
# are published through the admin API, so changing what a character costs needs
# no deploy and every old invoice stays reproducible. Same for the som-per-credit
# rate. Run `python devtools/seed_price_book.py` to get a working set locally.

# Credit granted to a new account when it verifies. 0 disables it.
BILLING_SIGNUP_BONUS_MICROS=0
BILLING_SIGNUP_BONUS_DAYS=30

# Below this, the wallet reports `is_low` and the client should prompt a top-up.
# 0 disables it.
BILLING_LOW_BALANCE_MICROS=0

# What happens when a live call runs out of credit mid-sentence. The caller gets
# a warning, then this much time and this much unfunded usage, and then the call
# ends cleanly. Whichever runs out first wins.
#
# The overrun is written off, not lent: a prepaid product should not acquire a
# debt nobody will collect, and refusing to let a balance go negative keeps the
# strongest guarantees in the schema intact. 5 000 000 micros is five credits.
BILLING_GRACE_SECONDS=30
BILLING_GRACE_MICROS=5000000

# How much of a realtime session to reserve up front, and the bounds on it. The
# hold is topped up as it is consumed; a *declined* top-up is the signal that
# the balance is running out, which is why it fires early — it buys the warning
# a hold-window of lead time instead of arriving with the disconnect.
BILLING_HOLD_SECONDS=120
BILLING_HOLD_MIN_MICROS=1000000
BILLING_HOLD_MAX_MICROS=500000000
BILLING_HOLD_EXTEND_AT_PERCENT=70

# Local day boundary for the daily usage rollups. UTC would put "today" five
# hours out for everyone using this.
BILLING_ROLLUP_TIMEZONE=Asia/Tashkent

# ---- Internal API (the microservices) -----------------------------------------
#
# The TTS, STT, chat and voice-agent services call /internal/v1 with HMAC-signed
# requests. Their credentials are *derived* from this one master key rather than
# stored, so the service_api_keys table holds nothing secret and a database dump
# yields no usable credential. Revoking a key is one UPDATE — no deploy, no key
# redistribution.
#
# The trade, stated plainly: whoever holds this holds every service key. Same
# blast radius as JWT_SECRET, guarded the same way — the app refuses to start
# outside development if this is the default, shorter than 32 bytes, or equal to
# JWT_SECRET. It must never equal JWT_SECRET: sharing them would let a metering
# service mint user sessions.
#
#   openssl rand -hex 32
#
INTERNAL_KEY_SECRET=dev-internal-secret-change-me-before-deploying

# How far a signed request's clock may be from ours. Clock drift is the single
# commonest reason an integration that worked yesterday stops working today, so
# the rejection carries our own time in the response body.
INTERNAL_SIGNATURE_WINDOW_SECONDS=300

# A kill switch for the whole /internal surface, independent of the nginx ACL.
INTERNAL_API_ENABLED=true

# Mint a key:  python3 devtools/mint_service_key.py --service voice_agent --label "prod"
# Poke it:     python3 devtools/sign_internal_request.py GET /internal/v1/health
# The contract the other team codes against: docs/INTERNAL_API.md

# ---- Metrics ------------------------------------------------------------------
#
# `GET /metrics`, for Prometheus. Off the API prefix, and off /internal too:
# Prometheus does not sign requests the way a microservice does, so the token
# below is the whole of its authentication.
#
# Recording is unconditional — this switch only decides whether the endpoint
# answers. A flag that silenced the counters as well would make a metrics bug
# look like an application bug.
METRICS_ENABLED=true

# Required outside development — without one `/metrics` answers 404 and the
# startup log says so. The reason is nginx: this API is reached through a
# `location /` proxy, so a route we add is public the moment it exists, and
# this one publishes call volumes, credit movements and how many wallets there
# are. It is not a boot failure, deliberately: a dashboard must never be able
# to fail a release of the API it watches.
#
#   openssl rand -hex 32
#
METRICS_TOKEN=

# The three aggregates read per scrape: credit held by unsettled sessions, open
# sessions, open batch jobs. No counter can know them — they survive restarts
# and they are sums of rows — and a hold that never came back is invisible
# without them.
METRICS_DB_GAUGES=true

# Local dashboard:  docker compose -f grafana/docker-compose.yml up -d
# Then:             http://localhost:3001

# ---- Recordings ---------------------------------------------------------------
#
# Keep every delivered synthesis: the text and its parameters in
# `tts_recordings`, the audio in a content-addressed file under the directory
# below. `GET /tts/recordings` lists them, `/audio` plays one back, and
# `DELETE /tts/recordings/{id}` erases one.
#
# Nothing on the billing path reads either, and a write that fails costs the
# recording rather than the synthesis — a full disk must never be able to break
# a stream somebody is paying for.
#
# It does mean keeping customer text and customer audio indefinitely: there is
# no automatic expiry, and `false` here turns the whole thing off.
RECORDINGS_ENABLED=true

# Relative to the working directory, which is /opt/synora-backend under
# systemd — inside the unit's one `ReadWritePaths=`, so `ProtectSystem=strict`
# does not have to be relaxed for it. Rough sizing: a wav is ~96 KB per second
# of speech at 48 kHz, so a thousand ten-second clips a day is about 1 GB.
RECORDINGS_DIR=data/recordings
